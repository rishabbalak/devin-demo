<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.costcodemo.wms</groupId>
    <artifactId>costco-wms-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>costco-api</artifactId>
  <name>Costco WMS :: API</name>
  <description>
    REST tier and the runnable application. Serves the digital endpoints and hosts the
    terminal, so both read and write the same system of record.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.costcodemo.wms</groupId>
      <artifactId>costco-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.costcodemo.wms</groupId>
      <artifactId>costco-terminal</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Springfox 3.0.0 is the last release this project ever made and it has no Spring Boot 3
      support. It also needs spring.mvc.pathmatch.matching-strategy set back to
      ant_path_matcher to start under Boot 2.6+, which is configured in application.properties.
    -->
    <dependency>
      <groupId>io.springfox</groupId>
      <artifactId>springfox-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
